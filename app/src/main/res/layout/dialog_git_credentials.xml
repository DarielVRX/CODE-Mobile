<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo para guardar el Personal Access Token de GitHub (integración
     GitHub básica), cifrado vía GitCredentialsStore. Un solo token global,
     reusado para push/pull/clone de cualquier repo — no distingue cuenta
     por repo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_elevated">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GitHub username"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/editGitUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="your-username"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_dim"
        android:inputType="text"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personal Access Token"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/editGitToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ghp_..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_dim"
        android:inputType="textPassword"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stored encrypted on the device. Generate it on GitHub → Settings → Developer settings → Personal access tokens."
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:paddingTop="10dp" />

</LinearLayout>
