<?xml version="1.0" encoding="utf-8"?>
<!-- Visor de log de un job de GitHub Actions a pantalla completa, dividido
     por steps colapsables (ver ActionsLogViewerController) — mismo
     esqueleto que view_html_preview.xml: header fijo arriba con botón de
     cerrar siempre visible, el resto del espacio para el contenido. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:background="@color/bg_elevated">

        <TextView
            android:id="@+id/logViewerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Job log"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/logViewerClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/logViewerStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Loading log..."
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/logViewerStepsRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
