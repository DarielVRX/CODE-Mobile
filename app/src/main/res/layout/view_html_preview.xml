<?xml version="1.0" encoding="utf-8"?>
<!-- Panel de preview HTML a pantalla completa (ver Task #30 y pedido
     posterior explícito: "muy pequeño, dale toda la pantalla asegurando
     tener un botón para cerrarlo"). htmlPreviewContainer (ver
     activity_editor.xml) ya es MATCH_PARENT como overlay de toda la
     pantalla; este layout solo reparte ese espacio: header fijo arriba
     (con el botón de cerrar, siempre visible) y el WebView ocupando todo
     el resto. Ya no tiene resize handle — no hace falta ajustar un alto
     parcial cuando el panel entero es la pantalla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:background="@color/bg_elevated">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/html_preview_title"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/htmlPreviewReload"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/html_preview_reload"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <!-- Botón de cerrar (pedido explícito, siempre debe existir): área
             táctil generosa (44dp, igual que el resto de botones de acción
             de la app) ya que es el único camino para salir del overlay a
             pantalla completa. -->
        <TextView
            android:id="@+id/htmlPreviewClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <WebView
        android:id="@+id/htmlPreviewWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
