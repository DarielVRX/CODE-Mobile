<?xml version="1.0" encoding="utf-8"?>
<!-- Item individual del branchListRecycler (ver view_git_branch_dropdown.xml
     / GitActionsController.BranchAdapter). La rama activa se marca con "*"
     al inicio del texto (mismo signo que ya usa GitRepository.branch() para
     la consola de texto), no con un ícono aparte, para mantener consistencia
     visual con lo que el usuario ya ve si usa la consola. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/branchItemText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:textColor="@color/text_primary"
    android:textSize="13sp" />
