<?xml version="1.0" encoding="utf-8"?>
<!-- Item individual de la lista de artifacts de un run (ver
     ActionsPanelController.ArtifactAdapter) — reusa el mismo shell de
     panel que runs/jobs. downloadButton descarga el zip a un archivo
     temporal y arranca el flujo de "elegir destino" del explorador (ver
     ExplorerController.startTransferOf) para que el usuario decida dónde
     guardarlo, igual que copiar/mover un archivo cualquiera. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/artifactNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/artifactMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/artifactDownloadButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="⬇"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
