<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_elevated">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_choose_type"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <!-- columnCount se fija dinámicamente en código según el ancho real de
         pantalla (ver EditorActivity.showNewFileDialog), igual patrón que el
         colorGrid anterior (ya resuelto el bug de rowCount/columnCount ahí:
         ver applyColumnsFromMeasuredWidth). Cada hijo es un chip de texto
         con el nombre del tipo (Python, JS, HTML, CSS, SQL, Texto plano,
         + Otro), no un círculo de color — el color ahora es fijo por
         extensión (ver colorIndexForExtension), no se elige a mano. -->
    <GridLayout
        android:id="@+id/typeGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- Fila de nombre: título editable + extensión editable, separados por
         un punto visual fijo. La extensión se autocompleta según el tipo
         elegido arriba (ver selectType en showNewFileDialog) pero sigue
         siendo editable a mano — pedido explícito del usuario. Con "Texto
         plano" queda vacía como estaba el comportamiento antes de este
         cambio (el usuario la escribe si quiere). Con "+ Otro" también
         queda vacía, lista para que el usuario tipee cualquier extensión
         libre. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editFileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_file_title"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="."
            android:textColor="@color/text_dim"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editFileExtension"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_file_extension"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:inputType="text"
            android:singleLine="true" />

    </LinearLayout>

</LinearLayout>
