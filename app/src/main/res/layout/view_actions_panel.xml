<?xml version="1.0" encoding="utf-8"?>
<!--
    Panel de GitHub Actions (ver ActionsPanelController.showRunsPanel): se
    infla dentro del mismo overlay patrón que el dropdown de ramas
    (gitActionsOverlay, FrameLayout hermano del root, MATCH_PARENT,
    intercepta touch fuera para cerrar). A diferencia del dropdown de
    ramas/panel de atajos (que viven dentro de la consola y por eso anclan
    siempre hacia ARRIBA, con el teclado propio ocupando la mitad de la
    pantalla), este panel se abre desde el explorador — sin teclado en
    pantalla, hay espacio real debajo del botón que lo abre, así que ancla
    hacia ABAJO.

    runsListRecycler usa layout_height=0dp + layout_weight=1: el panel
    entero crece para llenar TODO el espacio disponible entre el techo
    del explorador y el botón que lo abre (ver
    ActionsPanelController.openOverlayAbove, que fija lp.height a ese
    hueco en vez de medir el contenido), y el recycler ocupa lo que
    sobra del root después de la cabecera/divisor/statusText, con su
    propio scroll interno si hay más runs de los que entran.

    layout_width y layout_height de este root se sobreescriben en código
    (ver ActionsPanelController.openOverlayAbove: lp.width =
    explorerContainer.width, lp.height = hueco disponible) para acotar el
    panel a la sección del explorador, que es redimensionable — 280dp /
    wrap_content acá son solo los valores que se ven durante la medición
    inicial antes de ese ajuste.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_elevated"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GitHub Actions"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actionsRefreshButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_panel" />

    <TextView
        android:id="@+id/actionsStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center"
        android:padding="12dp"
        android:text="Loading runs..."
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/runsListRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
